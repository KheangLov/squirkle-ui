{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./pnpm-lock.yaml)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
