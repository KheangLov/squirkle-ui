{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@squirkle-ui/docs",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "vue2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@squirkle-ui/playground-vue2",
        "dev"
      ],
      "port": 5181
    },
    {
      "name": "nuxt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@squirkle-ui/playground-nuxt",
        "dev"
      ],
      "port": 5182
    },
    {
      "name": "nuxt-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/playground-nuxt/.output/server/index.mjs"
      ],
      "env": { "PORT": "5183" },
      "port": 5183
    },
    {
      "name": "docs-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@squirkle-ui/docs",
        "preview",
        "--port",
        "5184",
        "--strictPort"
      ],
      "port": 5184
    }
  ]
}
