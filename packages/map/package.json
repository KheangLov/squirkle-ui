{
  "name": "@squirkle-ui/map",
  "version": "0.1.1",
  "description": "Vector (MapLibre) and raster (Leaflet) squircle maps with custom markers and clustering for Squirkle UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KheangLov/squirkle-ui.git",
    "directory": "packages/map"
  },
  "homepage": "https://github.com/KheangLov/squirkle-ui#readme",
  "bugs": {
    "url": "https://github.com/KheangLov/squirkle-ui/issues"
  },
  "keywords": [
    "vue",
    "map",
    "maplibre",
    "leaflet",
    "clustering"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "vue2",
    "styles.css"
  ],
  "main": "./dist/vue3/index.cjs",
  "module": "./dist/vue3/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue3/index.mjs",
      "require": "./dist/vue3/index.cjs"
    },
    "./vue2": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue2/index.mjs",
      "require": "./dist/vue2/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/types/*": {
      "types": "./dist/types/*.d.ts"
    }
  },
  "peerDependencies": {
    "@squirkle-ui/ui": "workspace:^",
    "leaflet": "^1.9.0",
    "maplibre-gl": "^6.0.0",
    "vue": "^2.7.0 || ^3.3.0"
  },
  "dependencies": {
    "@squirkle-ui/core": "workspace:^",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@squirkle-ui/ui": "workspace:^",
    "@types/leaflet": "^1.9.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.15.0"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs map"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
