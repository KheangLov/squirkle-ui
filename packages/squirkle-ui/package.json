{
  "name": "squirkle-ui",
  "version": "0.1.1",
  "description": "Squircle-first Vue component library for Vue 2.7, Vue 3 and Nuxt — all components and add-ons in one package",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KheangLov/squirkle-ui.git",
    "directory": "packages/squirkle-ui"
  },
  "homepage": "https://github.com/KheangLov/squirkle-ui#readme",
  "bugs": {
    "url": "https://github.com/KheangLov/squirkle-ui/issues"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "nuxt",
    "components",
    "ui",
    "squircle",
    "design-system",
    "datagrid",
    "charts",
    "map"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vue2": {
      "types": "./dist/vue2.d.ts",
      "import": "./dist/vue2.mjs",
      "require": "./dist/vue2.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./datagrid": {
      "types": "./dist/datagrid/index.d.ts",
      "import": "./dist/datagrid/index.mjs",
      "require": "./dist/datagrid/index.cjs"
    },
    "./datagrid/vue2": {
      "types": "./dist/datagrid/vue2.d.ts",
      "import": "./dist/datagrid/vue2.mjs",
      "require": "./dist/datagrid/vue2.cjs"
    },
    "./datagrid/styles.css": "./dist/datagrid/styles.css",
    "./swiper": {
      "types": "./dist/swiper/index.d.ts",
      "import": "./dist/swiper/index.mjs",
      "require": "./dist/swiper/index.cjs"
    },
    "./swiper/vue2": {
      "types": "./dist/swiper/vue2.d.ts",
      "import": "./dist/swiper/vue2.mjs",
      "require": "./dist/swiper/vue2.cjs"
    },
    "./swiper/styles.css": "./dist/swiper/styles.css",
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "import": "./dist/calendar/index.mjs",
      "require": "./dist/calendar/index.cjs"
    },
    "./calendar/vue2": {
      "types": "./dist/calendar/vue2.d.ts",
      "import": "./dist/calendar/vue2.mjs",
      "require": "./dist/calendar/vue2.cjs"
    },
    "./calendar/styles.css": "./dist/calendar/styles.css",
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.mjs",
      "require": "./dist/map/index.cjs"
    },
    "./map/vue2": {
      "types": "./dist/map/vue2.d.ts",
      "import": "./dist/map/vue2.mjs",
      "require": "./dist/map/vue2.cjs"
    },
    "./map/styles.css": "./dist/map/styles.css",
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.mjs",
      "require": "./dist/charts/index.cjs"
    },
    "./charts/vue2": {
      "types": "./dist/charts/vue2.d.ts",
      "import": "./dist/charts/vue2.mjs",
      "require": "./dist/charts/vue2.cjs"
    },
    "./charts/styles.css": "./dist/charts/styles.css",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.mjs",
      "require": "./dist/icons/index.cjs"
    },
    "./icons/vue2": {
      "types": "./dist/icons/vue2.d.ts",
      "import": "./dist/icons/vue2.mjs",
      "require": "./dist/icons/vue2.cjs"
    },
    "./icons/styles.css": "./dist/icons/styles.css"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "maplibre-gl": "^6.0.0",
    "vue": "^2.7.0 || ^3.3.0"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "dependencies": {
    "@squirkle-ui/calendar": "workspace:^",
    "@squirkle-ui/charts": "workspace:^",
    "@squirkle-ui/core": "workspace:^",
    "@squirkle-ui/datagrid": "workspace:^",
    "@squirkle-ui/icons": "workspace:^",
    "@squirkle-ui/map": "workspace:^",
    "@squirkle-ui/swiper": "workspace:^",
    "@squirkle-ui/ui": "workspace:^"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs squirkle-ui"
  },
  "publishConfig": {
    "access": "public"
  }
}
