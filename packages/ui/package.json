{
  "name": "@squirkle/ui",
  "version": "0.1.0",
  "description": "Squircle-first Vue component library for Vue 2.7, Vue 3 and Nuxt 2/3/4",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/vue3/index.cjs",
  "module": "./dist/vue3/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/vue3/index.mjs",
      "require": "./dist/vue3/index.cjs"
    },
    "./vue2": {
      "import": "./dist/vue2/index.mjs",
      "require": "./dist/vue2/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "vue": "^2.7.0 || ^3.3.0"
  },
  "dependencies": {
    "@squirkle/core": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs ui"
  }
}
