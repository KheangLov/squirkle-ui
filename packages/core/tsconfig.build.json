// Emits .d.ts into dist/types; sibling packages resolve to their built types (built first by scripts/build.mjs).
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@squirkle-ui/ui": [
        "../ui/dist/types/index.d.ts"
      ],
      "@squirkle-ui/datagrid": [
        "../datagrid/dist/types/index.d.ts"
      ],
      "@squirkle-ui/swiper": [
        "../swiper/dist/types/index.d.ts"
      ],
      "@squirkle-ui/calendar": [
        "../calendar/dist/types/index.d.ts"
      ],
      "@squirkle-ui/map": [
        "../map/dist/types/index.d.ts"
      ],
      "@squirkle-ui/charts": [
        "../charts/dist/types/index.d.ts"
      ],
      "@squirkle-ui/icons": [
        "../icons/dist/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "test",
    "dist",
    "node_modules"
  ]
}
