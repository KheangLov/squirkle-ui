{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@squirkle-ui/core": ["packages/core/src/index.ts"],
      "@squirkle-ui/ui": ["packages/ui/src/index.ts"],
      "@squirkle-ui/datagrid": ["packages/datagrid/src/index.ts"],
      "@squirkle-ui/swiper": ["packages/swiper/src/index.ts"],
      "@squirkle-ui/calendar": ["packages/calendar/src/index.ts"],
      "@squirkle-ui/map": ["packages/map/src/index.ts"],
      "@squirkle-ui/charts": ["packages/charts/src/index.ts"],
      "@squirkle-ui/icons": ["packages/icons/src/index.ts"],
      "@squirkle-ui/editor": ["packages/editor/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.vue", "apps/docs/src/**/*.ts", "apps/docs/src/**/*.vue", "apps/storybook/stories/**/*.ts", "apps/storybook/.storybook/*.ts"],
  "exclude": ["packages/nuxt/**", "**/node_modules/**", "**/dist/**"]
}
